{
  "name": "AMP-Predictor Python 3.10",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": {
    "server": "python -m streamlit run app.py --server.headless true"
  },
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "AMP-Predictor",
      "onAutoForward": "openPreview"
    }
  }
}
